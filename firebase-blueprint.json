{
  "entities": {
    "Question": {
      "title": "Question",
      "description": "Assessment question bank item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "question": { "type": "string" },
        "options": { "type": "array" },
        "correctOptionId": { "type": "string" },
        "material": { "type": "string" },
        "submaterial": { "type": "string" },
        "difficulty": { "type": "string" },
        "explanation": { "type": "string" },
        "source": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["question", "options", "correctOptionId", "material"]
    },
    "Student": {
      "title": "Student",
      "description": "Student master data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nisn": { "type": "string" },
        "nis": { "type": "string" },
        "name": { "type": "string" },
        "className": { "type": "string" },
        "rombel": { "type": "string" }
      },
      "required": ["nisn", "name", "className"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Assessment exam package",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "subject": { "type": "string" },
        "grade": { "type": "string" },
        "semester": { "type": "string" },
        "materials": { "type": "string" },
        "totalQuestions": { "type": "number" },
        "durationMinutes": { "type": "number" },
        "kkm": { "type": "number" },
        "status": { "type": "string" },
        "accessCode": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "status", "accessCode"]
    },
    "Session": {
      "title": "Session",
      "description": "Student exam session and progress",
      "type": "object",
      "properties": {
        "examId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "className": { "type": "string" },
        "startTime": { "type": "number" },
        "submitted": { "type": "boolean" },
        "score": { "type": "number" }
      },
      "required": ["examId", "studentId", "startTime"]
    },
    "Violation": {
      "title": "Violation",
      "description": "Proctoring and exam security log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentName": { "type": "string" },
        "className": { "type": "string" },
        "timestamp": { "type": "number" },
        "timeFormatted": { "type": "string" },
        "activity": { "type": "string" },
        "severity": { "type": "string" }
      },
      "required": ["studentName", "activity", "timestamp"]
    }
  },
  "firestore": {
    "/questions/{questionId}": {
      "entity": "Question"
    },
    "/students/{studentId}": {
      "entity": "Student"
    },
    "/exams/{examId}": {
      "entity": "Exam"
    },
    "/sessions/{sessionId}": {
      "entity": "Session"
    },
    "/violations/{violationId}": {
      "entity": "Violation"
    }
  }
}
